#!/bin/bash
set -e

# 设置执行权限
chmod +x /opt/kylin-cleanup/*.sh 2>/dev/null || true
chmod +x /opt/kylin-cleanup/*.py 2>/dev/null || true

# 重新加载 systemd 守护进程
systemctl daemon-reload || true

# 预创建配置文件并赋予可写权限，避免 GUI 每次操作都弹窗授权
touch /opt/kylin-cleanup/config.sh || true
chmod 666 /opt/kylin-cleanup/config.sh || true
touch /etc/kylin-cleanup.lic || true
chmod 666 /etc/kylin-cleanup.lic || true

# 更新桌面数据库
if command -v update-desktop-database &> /dev/null; then
    update-desktop-database /usr/share/applications 2>/dev/null || true
fi

# 更新图标缓存 (尝试修复图标不显示)
if command -v gtk-update-icon-cache &> /dev/null; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
fi

# 自动部署桌面快捷方式
deploy_to_desktop() {
    local DESKTOP_DIR=""
    # 尝试寻找当前活跃用户的桌面目录
    local CURRENT_USER=$(whoami)
    if [ "$CURRENT_USER" = "root" ]; then
        # 如果是 sudo 安装，尝试获取真实用户名
        CURRENT_USER=${SUDO_USER:-$USER}
    fi
    
    local USER_HOME=$(eval echo ~$CURRENT_USER)
    
    # 适配中英文桌面目录
    if [ -d "$USER_HOME/桌面" ]; then
        DESKTOP_DIR="$USER_HOME/桌面"
    elif [ -d "$USER_HOME/Desktop" ]; then
        DESKTOP_DIR="$USER_HOME/Desktop"
    fi

    if [ -n "$DESKTOP_DIR" ]; then
        echo "正在部署快捷方式到用户 $CURRENT_USER 的桌面..."
        cp /usr/share/applications/kylin-cleanup*.desktop "$DESKTOP_DIR/"
        chown $CURRENT_USER:$CURRENT_USER "$DESKTOP_DIR"/kylin-cleanup*.desktop
        chmod +x "$DESKTOP_DIR"/kylin-cleanup*.desktop
        
        # Kylin / openKylin 系统有时需要设置信任
        if command -v gio &> /dev/null; then
            su - $CURRENT_USER -c "gio set \"$DESKTOP_DIR/kylin-cleanup.desktop\" metadata::trusted true" 2>/dev/null || true
        fi
    fi
}

deploy_to_desktop || true

# 自动启用并启动自动清理服务
echo "正在启用自动清理服务..."
systemctl enable kylin-clean-tools.service 2>/dev/null || true
systemctl start kylin-clean-tools.service 2>/dev/null || true

echo ""
echo "========================================"
echo "Kylin / openKylin 清理工具 (v1.3.9) 安装完成!"
echo "========================================"
echo ""
echo "功能亮点:"
echo "  - 已将「清理工具设置」快捷方式添加到桌面"
echo "  - 离线环境可直接使用 (已捆绑依赖)"
echo "  - 自动清理服务已启动并设为开机自启"
echo "  - 所有操作均可通过「清理工具设置」图形界面完成"
echo ""

exit 0
