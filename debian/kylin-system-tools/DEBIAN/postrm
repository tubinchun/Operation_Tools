#!/bin/bash
# postrm script for kylin-system-tools

remove_desktop_shortcut() {
    local shortcut_name="kylin-system-tools.desktop"
    
    # 删除所有用户桌面上的快捷方式
    for user_dir in /home/*; do
        if [ ! -d "$user_dir" ]; then
            continue
        fi
        
        # 尝试英文和中文桌面目录
        local desktop_dirs=("$user_dir/Desktop" "$user_dir/桌面")
        
        for desktop_dir in "${desktop_dirs[@]}"; do
            if [ -d "$desktop_dir" ]; then
                local desktop_shortcut="$desktop_dir/$shortcut_name"
                if [ -f "$desktop_shortcut" ]; then
                    rm -f "$desktop_shortcut" 2>/dev/null || true
                fi
            fi
        done
    done
}

clean_python_cache() {
    local base_dir="/usr/share/kylin-system-tools"
    
    # 清理所有 __pycache__ 目录
    find "$base_dir" -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
    
    # 清理所有 .pyc 文件
    find "$base_dir" -type f -name "*.pyc" -delete 2>/dev/null || true
    find "$base_dir" -type f -name "*.pyo" -delete 2>/dev/null || true
    
    # 清理 .pytest_cache 等测试缓存
    find "$base_dir" -type d -name ".pytest_cache" -exec rm -rf {} + 2>/dev/null || true
    find "$base_dir" -type d -name ".coverage" -exec rm -rf {} + 2>/dev/null || true
    
    # 清理 temp_iso_mount 等临时目录
    find "$base_dir" -type d -name "temp_iso_mount" -exec rm -rf {} + 2>/dev/null || true
    
    # 清理 netboot 中的临时文件
    local netboot_dir="$base_dir/tools/pxe/netboot"
    if [ -d "$netboot_dir" ]; then
        find "$netboot_dir" -type d -name "*.mount" -exec rm -rf {} + 2>/dev/null || true
    fi
}

clean_runtime_files() {
    local base_dirs=(
        "/usr/share/kylin-system-tools"
        "/var/lib/kylin-system-tools"
    )
    
    for base_dir in "${base_dirs[@]}"; do
        if [ -d "$base_dir" ]; then
            # 删除所有空目录
            find "$base_dir" -type d -empty -delete 2>/dev/null || true
            
            # 如果目录为空则删除
            if [ -d "$base_dir" ] && [ -z "$(ls -A "$base_dir" 2>/dev/null)" ]; then
                rmdir "$base_dir" 2>/dev/null || true
            fi
        fi
    done
}

case "$1" in
    remove)
        # 停止并禁用 kylin-clean-tools 服务
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop kylin-clean-tools.service 2>/dev/null || true
            systemctl disable kylin-clean-tools.service 2>/dev/null || true
            systemctl daemon-reload 2>/dev/null || true
        fi

        # 删除桌面图标快捷方式
        remove_desktop_shortcut
        
        # 清理Python缓存
        clean_python_cache
        ;;
    purge)
        # 停止并禁用 kylin-clean-tools 服务
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop kylin-clean-tools.service 2>/dev/null || true
            systemctl disable kylin-clean-tools.service 2>/dev/null || true
            systemctl daemon-reload 2>/dev/null || true
        fi

        # 删除桌面图标快捷方式
        remove_desktop_shortcut

        # 清理Python缓存和运行时文件
        clean_python_cache
        clean_runtime_files

        # 移除配置和数据
        rm -rf /etc/kylin-system-tools 2>/dev/null || true
        rm -rf /var/log/kylin-system-tools 2>/dev/null || true
        rm -rf /opt/kylin-clean 2>/dev/null || true
        rm -rf /var/lib/kylin-system-tools 2>/dev/null || true
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
