#!/bin/bash
# prerm script for kylin-system-tools

case "$1" in
    remove|upgrade|deconfigure)
        # 停止服务
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop kylin-system-tools.service 2>/dev/null || true
            systemctl disable kylin-system-tools.service 2>/dev/null || true
        fi
        ;;
    failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
