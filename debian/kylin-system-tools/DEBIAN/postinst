#!/bin/bash
# postinst script for kylin-system-tools

case "$1" in
    configure)
        # 设置权限
        chmod 755 /usr/bin/kylintools-server
        chmod 755 /usr/bin/kylintools-client
        chmod 755 /usr/share/kylin-system-tools/server/__main__.py
        chmod 755 /usr/share/kylin-system-tools/client/__main__.py

        # 启用服务（如果systemd可用）
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload 2>/dev/null || true
            systemctl enable kylin-system-tools.service 2>/dev/null || true
        fi

        echo "银河麒麟运维管理工具安装完成"
        echo "启动服务端: sudo kylintools-server"
        echo "启动客户端: kylintools-client"
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
